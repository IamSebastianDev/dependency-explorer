{
    "name": "@iasd/explorer",
    "version": "0.1.0",
    "description": "Instant local documentation for installed JavaScript packages.",
    "keywords": [
        "aurora",
        "dependencies",
        "documentation",
        "readme"
    ],
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Grainular-Nord/dependency-explorer.git"
    },
    "bin": {
        "explorer": "./dist/cli.mjs"
    },
    "files": [
        "dist",
        "src/aurora-config.ts",
        "src/custom.css",
        "src/markdown-transforms.ts",
        "README.md",
        "LICENSE"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.mts",
            "import": "./dist/index.mjs"
        },
        "./components/*": {
            "types": "./dist/components/*.d.mts",
            "import": "./dist/components/*.mjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "build": "tsdown",
        "dev": "tsdown --watch",
        "check": "tsc --noEmit",
        "test": "bun test",
        "lint": "oxlint . --deny-warnings",
        "format": "oxfmt . --write",
        "format:check": "oxfmt . --check",
        "hooks:install": "lefthook install",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "changeset publish",
        "prepublishOnly": "bun run format:check && bun run lint && bun run check && bun test && bun run build"
    },
    "dependencies": {
        "@grainular/aurora": "^2.3.1",
        "@grainular/grains": "^2.2.1",
        "@grainular/nord": "^2.2.1",
        "vite": "^7.3.1"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.1",
        "@commitlint/cli": "^21.2.2",
        "@commitlint/config-conventional": "^21.2.2",
        "@commitlint/types": "^21.2.0",
        "@types/bun": "^1.2.16",
        "@types/node": "^25.0.3",
        "lefthook": "^2.1.10",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.79.0",
        "tsdown": "^0.22.13",
        "typescript": "^7.0.2"
    },
    "engines": {
        "node": ">=22.12"
    }
}
